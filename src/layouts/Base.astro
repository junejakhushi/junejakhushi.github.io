---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Khushi Juneja",
  description =
    "Khushi Juneja builds apps, games, and the occasional research study at Carnegie Mellon. Operations research and HCI, graduating 2028.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

// JSON-LD Person schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: profile.links.site,
  email: `mailto:${profile.email}`,
  jobTitle: "Builder and researcher",
  description,
  knowsAbout: profile.knowsAbout,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pittsburgh",
    addressRegion: "PA",
    addressCountry: "US",
  },
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Carnegie Mellon University",
  },
  knowsLanguage: profile.languages.map((l) => l.name),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <!-- Resolve theme before paint: stored choice, else OS preference.
         Sets data-theme and the matching browser theme-color (no FOUC). -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark =
            stored === "dark" ||
            (!stored &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (stored === "light") dark = false;
          document.documentElement.setAttribute(
            "data-theme",
            dark ? "dark" : "light",
          );
        } catch (e) {}
        document.documentElement.classList.add("js");
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta
      name="theme-color"
      content="#faf8f4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#141310"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={profile.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon (inline SVG monogram) -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2316130f'/%3E%3Ctext x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='15' fill='%23faf8f4'%3EKJ%3C/text%3E%3C/svg%3E"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!-- Gentle on-scroll reveals via IntersectionObserver -->
    <script>
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const els = document.querySelectorAll("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

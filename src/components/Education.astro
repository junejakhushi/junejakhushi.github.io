---
// Education (brief §7): degrees, honors, editable minor, coursework.
import { education } from "../data/education";
---

<section class="section section--edu" id="education" aria-labelledby="edu-heading">
  <div class="shell edu">
    <div class="edu__head" data-reveal>
      <p class="eyebrow">Education</p>
      <h2 id="edu-heading" class="sec-title">{education.school}</h2>
      <p class="edu__meta">{education.location} · {education.expected}</p>
      <p class="edu__honors">{education.honors}</p>
    </div>

    <div class="edu__body" data-reveal>
      <ul class="degrees">
        {
          education.degrees.map((d) => (
            <li class="degree">
              <span class="degree__type">{d.type}</span>
              <span class="degree__field">{d.field}</span>
            </li>
          ))
        }
      </ul>

      <p class="minor">
        <span class="minor__label">Minor</span>
        {education.minor}
      </p>

      <div class="coursework">
        {
          education.coursework.map((grp, i) => (
            <details class="disc cw-group" open={i === 0}>
              <summary>
                <h3 class="cw-group__label">{grp.group}</h3>
                <span class="cw-group__count">{grp.items.length} courses</span>
              </summary>
              <div class="disc__body">
                <ul class="coursework__list">
                  {grp.items.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 860px) {
    .edu {
      grid-template-columns: 20rem 1fr;
      align-items: start;
    }
  }

  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
  }
  .edu__meta {
    margin-top: 0.6rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }
  .edu__honors {
    margin-top: 0.85rem;
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-accent-strong);
    background: var(--color-accent-tint);
    border: 1px solid var(--color-accent-border);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  .degrees {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .degree {
    padding: 0.9rem 1.1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-border);
    border-radius: 0 10px 10px 0;
  }
  .degree__type {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .degree__field {
    display: block;
    margin-top: 0.15rem;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .minor {
    margin-top: 1.1rem;
    font-size: 0.98rem;
    color: var(--color-ink-2);
  }
  .minor__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-right: 0.6rem;
  }

  .coursework {
    margin-top: 1.75rem;
  }
  .cw-group:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .cw-group > summary:hover .cw-group__label {
    color: var(--color-accent);
  }
  .cw-group__label {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.15s;
  }
  .cw-group__count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .coursework__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    column-gap: 1.5rem;
  }
  .coursework__list li {
    font-size: 0.92rem;
    color: var(--color-ink-2);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
</style>

---
// "Selected Data and Research Work" — the four featured case studies,
// each making the evidence-to-decision chain explicit.
// Data: src/data/caseStudies.ts
import { caseStudies } from "../data/caseStudies";
---

<section class="section" id="featured" aria-labelledby="featured-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">Selected Data and Research Work</p>
      <h2 id="featured-heading" class="sec-title">
        Evidence, and what it changed.
      </h2>
      <p class="sec-lede">
        Four studies, each traced from the question through the data and methods
        to the decision it enabled.
      </p>
    </div>

    <ul class="cases" role="list">
      {
        caseStudies.map((c) => (
          <li class="case" data-reveal>
            <div class="case__head">
              <span class:list={["case__status", `case__status--${c.status.toLowerCase()}`]}>
                {c.status}
              </span>
              {c.scale && <span class="case__scale">{c.scale}</span>}
            </div>

            <h3 class="case__title">
              <a href={`/projects/${c.slug}`}>{c.cardTitle}</a>
            </h3>

            <dl class="case__chain">
              <div class="case__row">
                <dt>Question</dt>
                <dd>{c.question}</dd>
              </div>
              <div class="case__row">
                <dt>Evidence</dt>
                <dd>{c.evidence}</dd>
              </div>
              <div class="case__row">
                <dt>Methods</dt>
                <dd>{c.methodsShort}</dd>
              </div>
              <div class="case__row case__row--result">
                <dt>Result</dt>
                <dd>{c.result}</dd>
              </div>
              <div class="case__row case__row--decision">
                <dt>Decision enabled</dt>
                <dd>{c.decision}</dd>
              </div>
              <div class="case__row">
                <dt>My role</dt>
                <dd>{c.role}</dd>
              </div>
            </dl>

            <ul class="case__tools" role="list">
              {c.tools.map((t) => (
                <li>{t}</li>
              ))}
            </ul>

            <a class="case__more" href={`/projects/${c.slug}`}>
              Read the case study
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
  }
  .sec-lede {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--color-ink-2);
    font-size: 1.02rem;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 27rem), 1fr));
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.5rem;
    transition:
      border-color 0.18s,
      box-shadow 0.18s;
  }
  .case:hover {
    border-color: var(--color-accent-border);
    box-shadow: 0 10px 30px rgba(40, 28, 12, 0.08);
  }

  .case__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .case__status {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent);
    background: var(--color-accent-tint);
  }
  .case__status--completed {
    color: var(--color-ink-2);
    background: transparent;
    border-color: var(--color-border-strong);
  }
  .case__scale {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .case__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.14;
  }
  .case__title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .case__title a:hover {
    color: var(--color-accent);
  }

  .case__chain {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .case__row {
    display: grid;
    gap: 0.15rem;
  }
  .case__row dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .case__row dd {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .case__row--result dd,
  .case__row--decision dd {
    color: var(--color-ink);
    font-weight: 500;
  }
  .case__row--result dt,
  .case__row--decision dt {
    color: var(--color-accent);
  }

  .case__tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .case__tools li {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.12rem 0.45rem;
    border-radius: 6px;
  }

  .case__more {
    margin-top: auto;
    padding-top: 0.3rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    gap: 0.35rem;
  }
  .case__more:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }
</style>

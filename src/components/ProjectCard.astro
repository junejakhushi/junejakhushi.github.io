---
// A project tile. Links to /projects/<id>. Reused by the featured row
// and the filterable grid; the data-categories attribute is what the
// grid filter reads.
import type { CollectionEntry } from "astro:content";
import Placeholder from "./Placeholder.astro";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const p = entry.data;
const href = `/projects/${entry.id}`;
---

<a
  class="card"
  href={href}
  data-categories={p.categories.join("|")}
  aria-label={`${p.title}, ${p.status}, ${p.year}`}
>
  <span class="card__media">
    {
      p.image ? (
        <img src={p.image.src} alt={p.image.alt} width="1200" height="750" loading="lazy" />
      ) : (
        <Placeholder label={p.monogram ?? ""} title={p.title} />
      )
    }
  </span>

  <span class="card__meta">
    <span class="card__year">{p.year}</span>
    <span class="card__status" data-status={p.status}>{p.status}</span>
  </span>

  <span class="card__title">{p.title}</span>
  <span class="card__summary">{p.summary}</span>

  {
    p.tags.length > 0 && (
      <span class="card__tags">
        {p.tags.slice(0, 4).map((t) => (
          <span class="card__tag">{t}</span>
        ))}
      </span>
    )
  }

  {
    p.builtWith.length > 0 && (
      <span class="card__built">{p.builtWith.join(" · ")}</span>
    )
  }
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .card:focus-visible {
    outline: 2.5px solid var(--color-accent);
    outline-offset: 3px;
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-border);
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.1rem 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .card__status::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-ink-2);
  }
  .card__status[data-status="Building"]::before {
    background: var(--color-accent);
  }
  .card__status[data-status="Research"]::before {
    background: transparent;
    border: 1px solid var(--color-ink-2);
  }

  .card__title {
    padding: 0.5rem 1.1rem 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .card__summary {
    padding: 0.5rem 1.1rem 0;
    color: var(--color-ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem 0;
  }
  .card__tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
    line-height: 1;
  }

  .card__built {
    margin-top: auto;
    padding: 0.9rem 1.1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
  }
</style>

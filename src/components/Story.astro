---
// How I Got Here (brief §7, optional): five-beat origin narrative
// as a slim vertical timeline.
import { timeline } from "../data/timeline";
---

<section class="section section--story" id="story" aria-labelledby="story-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">How I Got Here</p>
      <h2 id="story-heading" class="sec-title">One throughline, all along.</h2>
    </div>

    <ol class="beats">
      {
        timeline.map((beat) => (
          <li class="beat" data-reveal>
            <span class="beat__when">{beat.when}</span>
            <p class="beat__text">{beat.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
  }

  .beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 52rem;
  }
  .beat {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-border);
    align-items: baseline;
  }
  .beat:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .beat {
      grid-template-columns: 9rem 1fr;
    }
  }

  .beat__when {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }
  .beat__text {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 56ch;
  }
</style>

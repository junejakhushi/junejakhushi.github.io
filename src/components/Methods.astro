---
// "How I Evaluate Learning Systems" — the four-step method.
import { methodSteps } from "../data/methods";
---

<section class="section section--methods" id="method" aria-labelledby="method-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">Method</p>
      <h2 id="method-heading" class="sec-title">How I evaluate learning systems.</h2>
      <p class="sec-lede">
        The same loop whether the system is a tutor, a curriculum, or a
        classroom: find the failure, build the evidence, test the explanation,
        change the system.
      </p>
    </div>

    <ol class="steps" role="list">
      {
        methodSteps.map((step, i) => (
          <li class="step" data-reveal>
            <span class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section--methods {
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-sand) 14%, transparent)
    );
  }
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
    max-width: 20ch;
  }
  .sec-lede {
    margin-top: 0.9rem;
    max-width: 54ch;
    color: var(--color-ink-2);
    font-size: 1.02rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    counter-reset: step;
  }
  .step {
    border-top: 2px solid var(--color-accent-border);
    padding-top: 1.1rem;
  }
  .step__num {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .step__title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 0.45rem;
    color: var(--color-ink);
  }
  .step__body {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
</style>

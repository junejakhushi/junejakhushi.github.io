---
// How I Think (brief §7): philosophy points as editorial blocks +
// a large centered pull quote.
import { philosophy, pullQuote, philosophyHeading } from "../data/philosophy";
---

<section class="section section--phil" id="about" aria-labelledby="phil-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">How I Think</p>
      <h2 id="phil-heading" class="sec-title">{philosophyHeading}</h2>
    </div>

    <div class="phil-list">
      {
        philosophy.map((point, i) => (
          <article class="phil" data-reveal>
            <span class="phil__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="phil__title">{point.title}</h3>
            <p class="phil__body">{point.body}</p>
          </article>
        ))
      }
    </div>

    <blockquote class="pull" data-reveal>
      <p>“{pullQuote}”</p>
    </blockquote>
  </div>
</section>

<style>
  .section--phil {
    background:
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--color-sand) 14%, transparent)
      );
  }
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
    max-width: 20ch;
  }

  .phil-list {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .phil {
    border-top: 2px solid var(--color-accent-border);
    padding-top: 1.2rem;
  }
  .phil__num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .phil__title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-top: 0.5rem;
    color: var(--color-ink);
  }
  .phil__body {
    margin-top: 0.7rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .pull {
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    max-width: 24ch;
    text-align: center;
  }
  .pull p {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.6rem, 4.5vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
</style>

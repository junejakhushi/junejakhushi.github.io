---
// How I Think (brief §7): philosophy points as editorial blocks +
// a large centered pull quote.
import { philosophy, pullQuote, philosophyHeading } from "../data/philosophy";
---

<section class="section section--phil" id="about" aria-labelledby="phil-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">How I Think</p>
      <h2 id="phil-heading" class="sec-title">{philosophyHeading}</h2>
    </div>

    <div class="phil-list" data-reveal>
      {
        philosophy.map((point, i) => (
          <details class="disc phil">
            <summary>
              <span class="phil__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="phil__title">{point.title}</h3>
            </summary>
            <div class="disc__body">
              <p class="phil__body">{point.body}</p>
            </div>
          </details>
        ))
      }
    </div>

    <blockquote class="pull" data-reveal>
      <p>“{pullQuote}”</p>
    </blockquote>
  </div>
</section>

<style>
  .section--phil {
    background:
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--color-sand) 14%, transparent)
      );
  }
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
    max-width: 20ch;
  }

  .phil-list {
    display: block;
    max-width: 62rem;
  }
  .phil:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }
  .phil > summary:hover .phil__title {
    color: var(--color-accent);
  }
  .phil__num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .phil__title {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color 0.15s;
  }
  .phil__body {
    padding-left: 2.05rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-ink-2);
    max-width: 68ch;
  }

  .pull {
    margin: clamp(3rem, 7vw, 5rem) auto 0;
    max-width: 24ch;
    text-align: center;
  }
  .pull p {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.6rem, 4.5vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
</style>

---
// About: a few short paragraphs in her voice, with a compact
// education block and the named toolbox alongside.
import { about } from "../data/about";
import { education as ed } from "../data/education";
---

<section class="about section" id="about" aria-labelledby="about-heading">
  <div class="shell about__grid">
    <div class="about__prose" data-reveal>
      <p class="eyebrow">About</p>
      <h2 id="about-heading" class="about__title">A bit more</h2>
      {about.paragraphs.map((p) => <p class="about__p">{p}</p>)}
    </div>

    <aside class="about__side" data-reveal>
      <div class="about__block">
        <h3 class="about__label">Education</h3>
        <p class="about__school">{ed.school}</p>
        <p class="about__edmeta">{ed.location} · {ed.expected}</p>
        <ul class="about__degrees">
          <li>{ed.degree}</li>
          <li>Additional major in {ed.additionalMajor}</li>
          <li>Minors in {ed.minors.join(" and ")}</li>
        </ul>
      </div>

      <div class="about__block">
        <h3 class="about__label">Tools I reach for</h3>
        <ul class="about__tools">
          {about.toolbox.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .about__title {
    font-size: var(--text-h2);
    margin-top: 0.7rem;
    margin-bottom: 1.5rem;
  }
  .about__p {
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--color-ink-2);
    max-width: 56ch;
  }
  .about__p + .about__p {
    margin-top: 1.15rem;
  }

  .about__side {
    display: grid;
    gap: 2rem;
    position: sticky;
    top: 6rem;
  }
  @media (max-width: 859px) {
    .about__side {
      position: static;
    }
  }

  .about__block {
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
  }
  .about__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .about__school {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .about__edmeta {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .about__degrees {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .about__degrees li {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-ink-2);
    padding-left: 1rem;
    position: relative;
  }
  .about__degrees li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .about__tools {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .about__tools li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--color-ink-2);
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    line-height: 1;
  }
</style>

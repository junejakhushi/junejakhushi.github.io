---
// About: two short paragraphs, then Education. All copy from site.json.
import site from "../data/site.json";
const ed = site.education;
---

<section class="about section" id="about" aria-labelledby="about-heading">
  <div class="shell about__grid">
    <div class="about__prose">
      <p class="eyebrow">About</p>
      <h2 id="about-heading" class="about__title">A bit about me</h2>
      {site.about.map((p) => <p class="about__p">{p}</p>)}
    </div>

    <aside class="about__edu" aria-label="Education">
      <h3 class="about__label">Education</h3>
      <p class="about__school">{ed.school}</p>
      <p class="about__edmeta">{ed.location} · {ed.dates}</p>
      <ul class="about__degrees">
        <li>{ed.degree}</li>
        <li>Additional major in {ed.additionalMajor}</li>
        <li>Minors in {ed.minors.join(" and ")}</li>
        <li>{ed.honors}</li>
      </ul>
      <p class="about__langs">{site.spokenLanguages}</p>
    </aside>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .about__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
    margin-bottom: 1.4rem;
  }
  .about__p {
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--color-ink-2);
    max-width: 58ch;
  }
  .about__p + .about__p {
    margin-top: 1.15rem;
  }

  .about__edu {
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
  }
  .about__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .about__school {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-ink);
  }
  .about__edmeta {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .about__degrees {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .about__degrees li {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-ink-2);
    padding-left: 1rem;
    position: relative;
  }
  .about__degrees li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .about__langs {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>

---
// Projects gallery: data & research work first, then broader
// creative/technical work. Cards for the featured case studies link
// to their dedicated page; the rest open a lightweight modal
// (native <dialog>, full keyboard + screen-reader support).
// Data: src/data/projects.ts (which merges in src/data/caseStudies.ts)
import { galleryItems } from "../data/projects";
import { tagOrder } from "../data/tags";

// Only show filters for tags actually in use.
const usedTags = tagOrder.filter((t) =>
  galleryItems.some((p) => p.tags.includes(t)),
);
---

<section class="section" id="projects" aria-labelledby="projects-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">All Projects</p>
      <h2 id="projects-heading" class="sec-title">Everything else I've built.</h2>
      <p class="sec-lede">
        Data and research work first, then the simulation, game, and
        computer-vision projects. Filter by method.
      </p>
    </div>

    <div class="filters" role="group" aria-label="Filter projects by method" data-reveal>
      <button class="filter is-active" type="button" data-filter="all" aria-pressed="true">
        All
      </button>
      {
        usedTags.map((tag) => (
          <button class="filter" type="button" data-filter={tag} aria-pressed="false">
            {tag}
          </button>
        ))
      }
    </div>

    <p class="sr-only" aria-live="polite" data-count></p>

    <ul class="grid" data-grid role="list">
      {
        galleryItems.map((p, i) => (
          <li class="grid__cell" data-tags={p.tags.join("|")}>
            {p.href ? (
              <a class="card card--link" href={p.href}>
                <span class="card__eyebrow">{p.eyebrow}</span>
                <h3 class="card__title">{p.title}</h3>
                <p class="card__summary">{p.summary}</p>
                {p.tech && <p class="card__tech">{p.tech.join(" · ")}</p>}
                <span class="card__more" aria-hidden="true">
                  Read the case study →
                </span>
              </a>
            ) : (
              <button
                class="card"
                type="button"
                data-card={i}
                aria-haspopup="dialog"
                data-title={p.title}
                data-desc={p.description}
                data-tags-list={p.tags.join("|")}
                data-tech={p.tech ? p.tech.join("|") : ""}
              >
                <span class="card__eyebrow">{p.eyebrow}</span>
                <h3 class="card__title">
                  {p.title}
                  {p.subtitle && <span class="card__subtitle">{p.subtitle}</span>}
                </h3>
                <p class="card__summary">{p.summary}</p>
                {p.tech && <p class="card__tech">{p.tech.join(" · ")}</p>}
                <span class="card__more" aria-hidden="true">
                  Read more →
                </span>
              </button>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Shared modal, populated by JS -->
<dialog class="modal" data-modal aria-labelledby="modal-title">
  <div class="modal__inner">
    <button class="modal__close" type="button" data-modal-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
    <p class="modal__tags" data-modal-tags></p>
    <h3 class="modal__title" id="modal-title" data-modal-title></h3>
    <p class="modal__desc" data-modal-desc></p>
    <p class="modal__tech" data-modal-tech></p>
  </div>
</dialog>

<style>
  .sec-head {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
  }
  .sec-lede {
    margin-top: 0.9rem;
    max-width: 50ch;
    color: var(--color-ink-2);
    font-size: 1.02rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }
  .filter {
    border: 1px solid var(--color-border-strong);
    background: var(--color-paper);
    color: var(--color-ink-2);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .filter:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter.is-active {
    background: var(--color-ink);
    color: var(--color-cream);
    border-color: var(--color-ink);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.1rem;
  }
  .grid__cell[hidden] {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    width: 100%;
    height: 100%;
    text-align: left;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.35rem 1.35rem 1.5rem;
    cursor: pointer;
    text-decoration: none;
    transition:
      border-color 0.18s,
      box-shadow 0.18s,
      transform 0.18s var(--ease-out);
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--color-accent-border);
    box-shadow: 0 10px 30px rgba(40, 28, 12, 0.1);
    transform: translateY(-3px);
  }
  /* Case-study cards read as the primary work */
  .card--link {
    border-left: 3px solid var(--color-accent-border);
  }
  .card--link:hover {
    border-left-color: var(--color-accent);
  }

  .card__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1.3;
  }
  .card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.12;
    color: var(--color-ink);
  }
  .card__subtitle {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }
  .card__summary {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .card__tech {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .card__more {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: transform 0.15s var(--ease-out);
  }
  .card:hover .card__more {
    transform: translateX(3px);
  }

  /* ── Modal ── */
  .modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(40rem, 92vw);
    height: fit-content;
    max-height: 85vh;
    border: 1px solid var(--color-border-strong);
    border-radius: 16px;
    padding: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 24px 70px rgba(40, 28, 12, 0.32);
  }
  .modal::backdrop {
    background: rgba(28, 22, 17, 0.45);
    backdrop-filter: blur(2px);
  }
  .modal__inner {
    position: relative;
    padding: clamp(1.6rem, 4vw, 2.5rem);
  }
  .modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    color: var(--color-ink-2);
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .modal__close:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .modal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 2.5rem 0.9rem 0;
  }
  /* spans are created by JS, so scope must be global to style them */
  .modal__tags :global(span) {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-tint);
    border: 1px solid var(--color-accent-border);
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
  }
  .modal__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.1;
    margin-bottom: 0.85rem;
  }
  .modal__desc {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .modal__tech {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .modal__tech:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  // ---- Filtering ----
  const grid = document.querySelector<HTMLElement>("[data-grid]");
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const cells = grid
    ? Array.from(grid.querySelectorAll<HTMLElement>(".grid__cell"))
    : [];

  function applyFilter(tag: string) {
    let shown = 0;
    for (const cell of cells) {
      const tags = (cell.dataset.tags ?? "").split("|");
      const match = tag === "all" || tags.includes(tag);
      cell.hidden = !match;
      if (match) shown++;
    }
    if (count) {
      count.textContent =
        tag === "all"
          ? `Showing all ${shown} projects.`
          : `Showing ${shown} project${shown === 1 ? "" : "s"} tagged ${tag}.`;
    }
  }

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((b) => {
        b.classList.remove("is-active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("is-active");
      btn.setAttribute("aria-pressed", "true");
      applyFilter(btn.dataset.filter ?? "all");
    });
  });

  // ---- Modal (only for cards without a dedicated page) ----
  const modal = document.querySelector<HTMLDialogElement>("[data-modal]");
  const mTags = modal?.querySelector<HTMLElement>("[data-modal-tags]");
  const mTitle = modal?.querySelector<HTMLElement>("[data-modal-title]");
  const mDesc = modal?.querySelector<HTMLElement>("[data-modal-desc]");
  const mTech = modal?.querySelector<HTMLElement>("[data-modal-tech]");
  const closeBtn = modal?.querySelector<HTMLButtonElement>("[data-modal-close]");
  let lastTrigger: HTMLElement | null = null;

  function openCard(btn: HTMLElement) {
    if (!modal || !mTags || !mTitle || !mDesc || !mTech) return;
    lastTrigger = btn;
    mTitle.textContent = btn.dataset.title ?? "";
    mDesc.textContent = btn.dataset.desc ?? "";
    mTags.innerHTML = "";
    (btn.dataset.tagsList ?? "")
      .split("|")
      .filter(Boolean)
      .forEach((t) => {
        const span = document.createElement("span");
        span.textContent = t;
        mTags.appendChild(span);
      });
    const tech = (btn.dataset.tech ?? "").split("|").filter(Boolean);
    mTech.textContent = tech.length ? `Built with ${tech.join(" · ")}` : "";
    modal.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-card]").forEach((btn) => {
    btn.addEventListener("click", () => openCard(btn));
  });

  closeBtn?.addEventListener("click", () => modal?.close());
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
  modal?.addEventListener("close", () => {
    lastTrigger?.focus();
    lastTrigger = null;
  });
</script>

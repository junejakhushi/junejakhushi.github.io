---
// Skills (brief §7): four labeled groups, clean chips. Scannable.
import { skills } from "../data/skills";
---

<section class="section" id="skills" aria-labelledby="skills-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">Skills</p>
      <h2 id="skills-heading" class="sec-title">The toolkit.</h2>
    </div>

    <div class="skill-groups" data-reveal>
      {
        skills.map((group, i) => (
          <details
            class:list={[
              "disc",
              "skill-group",
              { "skill-group--secondary": group.secondary },
            ]}
            open={i === 0}
          >
            <summary>
              <h3 class="skill-group__label">{group.label}</h3>
              <span class="skill-group__count">{group.items.length}</span>
            </summary>
            <div class="disc__body">
              <ul class="chips">
                {group.items.map((item) => (
                  <li class="chip">{item}</li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sec-head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
  }

  .skill-groups {
    display: block;
  }
  .skill-group:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .skill-group > summary:hover .skill-group__label {
    color: var(--color-accent);
  }

  .skill-group__label {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color 0.15s;
  }
  .skill-group--secondary .skill-group__label {
    color: var(--color-muted);
  }
  .skill-group__count {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chip {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink-2);
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .chip:hover {
    border-color: var(--color-accent-border);
    color: var(--color-accent);
  }

  /* Secondary groups stay present but visually recede */
  .skill-group--secondary .chip {
    background: transparent;
    color: var(--color-muted);
    border-color: var(--color-border);
    font-size: 0.84rem;
  }
</style>

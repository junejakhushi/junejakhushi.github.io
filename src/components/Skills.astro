---
// Skills: grouped chips. Groups and items come from skills.json.
import skills from "../data/skills.json";
---

<section class="skills section" id="skills" aria-labelledby="skills-heading">
  <div class="shell">
    <header class="skills__head">
      <p class="eyebrow">Skills</p>
      <h2 id="skills-heading" class="skills__title">What I work with</h2>
    </header>

    <dl class="skills__groups">
      {
        skills.map((group) => (
          <div class="skills__group">
            <dt class="skills__label">{group.label}</dt>
            <dd class="skills__items">
              <ul>
                {group.items.map((item) => (
                  <li class="skills__chip">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .skills__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }

  .skills__groups {
    display: grid;
    gap: 0;
    margin: 0;
  }
  .skills__group {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.1rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--color-border);
  }
  .skills__group:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 720px) {
    .skills__group {
      grid-template-columns: 14rem 1fr;
      align-items: start;
    }
  }

  .skills__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-top: 0.2rem;
  }
  .skills__items ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skills__chip {
    font-size: 0.88rem;
    color: var(--color-ink-2);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.35rem 0.7rem;
    line-height: 1.2;
  }
</style>

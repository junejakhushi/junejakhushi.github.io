---
// Accessible evidence-chain diagram, built from HTML + CSS only.
// Renders as an ordered list (meaningful to screen readers and with
// CSS disabled); the arrows are decorative. A text alternative is
// exposed via the caption so the diagram is never image-only.
import type { EvidenceChainStep } from "../data/caseStudies";

interface Props {
  steps: EvidenceChainStep[];
  alt: string;
  /** Renders the last step as a loop-back (used by the LLM eval cycle). */
  loop?: boolean;
}
const { steps, alt, loop = false } = Astro.props;
---

<figure class="chain">
  <ol class="chain__list" role="list">
    {
      steps.map((step, i) => (
        <li
          class:list={[
            "chain__step",
            { "chain__step--last": loop && i === steps.length - 1 },
          ]}
        >
          <span class="chain__index" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="chain__label">{step.label}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="chain__caption">{alt}</figcaption>
</figure>

<style>
  .chain {
    margin: 0;
  }

  /* Single row so the connectors always point at a real next step.
     Scrolls inside its own container rather than wrapping (a wrapped
     row would leave an arrow pointing at nothing). */
  .chain__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.4rem;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.6rem;
    align-items: stretch;
    overflow-x: auto;
  }

  .chain__step {
    position: relative;
    flex: 1 0 7rem;
    min-width: 7rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 0.9rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent-border);
    border-radius: 10px;
  }
  .chain__step--last {
    border-top-color: var(--color-accent);
    background: var(--color-accent-tint);
  }

  /* Decorative connector between steps */
  .chain__step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -0.55rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-muted);
  }
  /* Stack vertically on small screens; connectors point down */
  @media (max-width: 640px) {
    .chain__list {
      flex-direction: column;
      gap: 1.1rem;
      overflow-x: visible;
    }
    .chain__step:not(:last-child)::after {
      content: "↓";
      right: 50%;
      top: auto;
      bottom: -0.85rem;
      transform: translateX(50%);
    }
  }

  .chain__index {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .chain__label {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .chain__caption {
    margin-top: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 62ch;
  }
</style>

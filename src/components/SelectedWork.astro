---
// Selected work strip for the main page: at most 3 featured cards and
// a link to the full projects page. The full grid lives at /projects.
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section class="work section" id="work" aria-labelledby="work-heading">
  <div class="shell">
    <header class="work__head">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-heading" class="work__title">Things I have built</h2>
    </header>

    <div class="work__grid">
      {featured.map((entry) => <ProjectCard entry={entry} />)}
    </div>

    <a class="work__all" href="/projects">
      See all projects <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .work__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .work__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }
  .work__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .work__all {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-accent-strong);
    text-decoration: none;
  }
  .work__all span {
    transition: transform 0.15s var(--ease-out);
  }
  .work__all:hover span {
    transform: translateX(4px);
  }
</style>

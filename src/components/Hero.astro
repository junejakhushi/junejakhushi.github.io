---
// Hero: specialization-first headline, supporting copy, three
// credibility indicators, availability, and primary links.
import { profile } from "../data/profile";
import ResumeButton from "./ResumeButton.astro";
---

<section class="hero" id="top">
  <div class="shell hero__inner">
    <p class="hero__eyebrow">{profile.eyebrow}</p>

    <p class="hero__name">
      {profile.name}
      <span class="hero__pronouns">{profile.pronouns}</span>
    </p>

    <h1 class="hero__headline">{profile.headline}</h1>

    <p class="hero__positioning">{profile.positioning}</p>

    <ul class="hero__credibility">
      {
        profile.credibility.map((item) => (
          <li>
            <span class="hero__cred-mark" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>

    <p class="hero__availability">
      <span class="hero__avail-dot" aria-hidden="true"></span>
      <span class="hero__avail-long">{profile.availability}</span>
      <span class="hero__avail-short">{profile.availabilityShort}</span>
    </p>

    <div class="hero__ctas">
      <a class="hero__primary" href="#featured">View Work</a>
      <ResumeButton variant="ghost" />
      <a class="hero__secondary" href={`mailto:${profile.email}`}>Email</a>
      <a
        class="hero__secondary"
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener">LinkedIn</a
      >
      <a
        class="hero__secondary"
        href={profile.links.github}
        target="_blank"
        rel="noopener">GitHub</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vh, 6rem) clamp(2.5rem, 6vh, 4rem);
  }
  .hero__inner {
    max-width: 58rem;
  }

  .hero__eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Name is secondary to the headline — the H1 carries the specialization. */
  .hero__name {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    line-height: 1.1;
  }
  .hero__pronouns {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-muted);
    margin-left: 0.5rem;
  }

  .hero__headline {
    margin-top: 0.85rem;
    font-size: clamp(2.1rem, 5.4vw, 3.9rem);
    font-weight: 480;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    max-width: 20ch;
  }

  .hero__positioning {
    margin-top: 1.35rem;
    font-size: clamp(1.02rem, 1.9vw, 1.22rem);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  .hero__credibility {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .hero__credibility li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero__cred-mark {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.75rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--color-accent-tint);
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent-strong);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .hero__avail-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .hero__avail-short {
    display: none;
  }
  /* Swap to the concise availability line on smaller screens */
  @media (max-width: 700px) {
    .hero__avail-long {
      display: none;
    }
    .hero__avail-short {
      display: inline;
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .hero__primary,
  .hero__secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.4rem;
    border-radius: 9px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s,
      transform 0.1s;
  }
  .hero__primary {
    background: var(--color-ink);
    color: var(--color-cream);
    border: 1px solid var(--color-ink);
  }
  .hero__primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
    transform: translateY(-1px);
  }
  .hero__secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-border-strong);
  }
  .hero__secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__primary:hover {
      transform: none;
    }
  }
</style>

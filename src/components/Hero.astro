---
// Hero: name, location, a one-line positioning statement, contact
// buttons, and an editable "currently" line. Resume link appears only
// when enabled in site.json.
import site from "../data/site.json";
import ResumeButton from "./ResumeButton.astro";
---

<section class="hero" aria-label="Introduction">
  <div class="shell hero__inner">
    <p class="meta hero__loc">{site.location}</p>
    <h1 class="hero__name">{site.name}</h1>
    <p class="hero__positioning">{site.positioning}</p>

    <div class="hero__cta">
      <a class="btn btn--solid" href={`mailto:${site.email}`}>Email</a>
      <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={site.links.github} target="_blank" rel="noopener">GitHub</a>
      <ResumeButton variant="ghost" />
    </div>

    <p class="hero__currently">
      <span class="hero__currently-label">Currently</span>
      {site.currently}
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
  }
  .hero__loc {
    margin-bottom: 1.25rem;
  }
  .hero__name {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .hero__positioning {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 2rem);
    line-height: 1.22;
    font-weight: 400;
    color: var(--color-ink-2);
    max-width: 30ch;
    text-wrap: balance;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 1.2rem;
    border-radius: 9px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s,
      transform 0.1s var(--ease-out);
  }
  .btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
    transform: translateY(-1px);
  }
  .btn--solid {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .btn--solid:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-accent-ink);
  }

  .hero__currently {
    margin-top: 2.25rem;
    font-size: 0.98rem;
    color: var(--color-ink-2);
    max-width: 52ch;
    line-height: 1.6;
  }
  .hero__currently-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin-right: 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover {
      transform: none;
    }
  }
</style>

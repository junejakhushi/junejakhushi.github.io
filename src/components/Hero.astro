---
// Hero: name, one sentence about what she does, one line about where
// she is. No availability paragraph. The name is the display piece.
import { profile } from "../data/profile";
---

<section class="hero" aria-label="Introduction">
  <div class="shell hero__inner">
    <p class="eyebrow hero__eyebrow">{profile.eyebrow}</p>

    <h1 class="hero__name">Khushi<br />Juneja</h1>

    <p class="hero__line">{profile.headline}</p>
    <p class="hero__sub">{profile.positioning}</p>

    <p class="meta hero__place">{profile.place}</p>

    <div class="hero__cta">
      <a class="hero__btn" href="#work">See the work</a>
      <a class="hero__ghost" href={`mailto:${profile.email}`}>Email</a>
      <a
        class="hero__ghost"
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener">LinkedIn</a
      >
      <a
        class="hero__ghost"
        href={profile.links.github}
        target="_blank"
        rel="noopener">GitHub</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 8rem) clamp(2.5rem, 7vw, 5rem);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
  }

  .hero__eyebrow {
    margin-bottom: 1.5rem;
  }

  .hero__name {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }

  .hero__line {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2.15rem);
    line-height: 1.15;
    font-weight: 400;
    color: var(--color-ink);
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero__sub {
    margin-top: 1.1rem;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 48ch;
  }

  .hero__place {
    margin-top: 1.75rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.25rem;
  }
  .hero__btn {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.7rem 1.4rem;
    border-radius: 9px;
    border: 1px solid var(--color-accent);
    transition:
      background 0.15s,
      transform 0.1s var(--ease-out);
  }
  .hero__btn:hover {
    background: var(--color-accent-strong);
    color: var(--color-accent-ink);
    transform: translateY(-1px);
  }
  .hero__ghost {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-ink-2);
    text-decoration: none;
    padding: 0.7rem 0.5rem;
    border-bottom: 1.5px solid transparent;
  }
  .hero__ghost:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__btn:hover {
      transform: none;
    }
  }
</style>

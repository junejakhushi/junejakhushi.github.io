---
// Contact. Email, LinkedIn, GitHub, resume (gated), and one line on
// what she is looking for. Theme-aware panel, no inversion.
import { profile } from "../data/profile";
import ResumeButton from "./ResumeButton.astro";

const year = new Date().getFullYear();
---

<footer class="footer" id="contact" aria-labelledby="contact-heading">
  <div class="shell">
    <div class="footer__top" data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-heading" class="footer__title">Say hello.</h2>
      <p class="footer__lede">{profile.lookingFor}</p>

      <a class="footer__email" href={`mailto:${profile.email}`}>
        {profile.email}
        <span aria-hidden="true">→</span>
      </a>

      <div class="footer__actions">
        <ResumeButton variant="solid" />
        <a
          class="footer__link"
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener">LinkedIn →</a
        >
        <a
          class="footer__link"
          href={profile.links.github}
          target="_blank"
          rel="noopener">GitHub →</a
        >
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__langs">
        <span class="footer__langs-label">Languages</span>
        {profile.languages.map((l) => `${l.name} (${l.level})`).join(" · ")}
      </p>
      <p class="footer__meta">
        © {year} {profile.name} · {profile.location} · Built with Astro
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-2);
    border-top: 1px solid var(--color-border);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .footer__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-top: 0.5rem;
    color: var(--color-ink);
  }
  .footer__lede {
    margin-top: 1.25rem;
    max-width: 46ch;
    color: var(--color-ink-2);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    font-weight: 400;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent-border);
    padding-bottom: 0.15rem;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .footer__email span {
    transition: transform 0.15s var(--ease-out);
  }
  .footer__email:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }
  .footer__email:hover span {
    transform: translateX(4px);
  }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .footer__link {
    color: var(--color-ink-2);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }
  .footer__link:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .footer__bottom {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .footer__langs,
  .footer__meta {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .footer__langs-label {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.7rem;
    color: var(--color-accent-strong);
    margin-right: 0.6rem;
  }
</style>

---
// Contact footer: email, LinkedIn, GitHub, and a build-time
// last-updated date.
import site from "../data/site.json";

const updated = new Date().toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});
---

<footer class="footer" id="contact" aria-labelledby="contact-heading">
  <div class="shell">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-heading" class="footer__title">Let's talk.</h2>
    <a class="footer__email" href={`mailto:${site.email}`}>
      {site.email}
      <span aria-hidden="true">→</span>
    </a>

    <div class="footer__links">
      <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
    </div>

    <div class="footer__base">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p>Last updated {updated} · Built with Astro</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-2);
    padding-block: clamp(3rem, 7vw, 5rem) 2.5rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }
  .footer__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-top: 0.5rem;
    color: var(--color-ink);
  }
  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent-border);
    padding-bottom: 0.15rem;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .footer__email span {
    transition: transform 0.15s var(--ease-out);
  }
  .footer__email:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent);
  }
  .footer__email:hover span {
    transform: translateX(4px);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .footer__links a {
    color: var(--color-ink-2);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }
  .footer__links a:hover {
    color: var(--color-accent-strong);
    border-bottom-color: var(--color-accent);
  }
  .footer__base {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .footer__base p {
    margin: 0;
  }
</style>

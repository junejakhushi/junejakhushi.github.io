---
// Who I've communicated findings to.
// Data: profile.stakeholders — only audiences supported by real work.
import { profile } from "../data/profile";
---

<section class="section" id="stakeholders" aria-labelledby="stakeholders-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">Communicating Evidence</p>
      <h2 id="stakeholders-heading" class="sec-title">
        Findings only matter if someone can act on them.
      </h2>
      <p class="sec-lede">
        Audiences I've translated research and evaluation findings for:
      </p>
    </div>

    <ul class="aud" role="list">
      {
        profile.stakeholders.map((s) => (
          <li class="aud__item" data-reveal>
            <h3 class="aud__who">{s.audience}</h3>
            <p class="aud__what">{s.context}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sec-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
    max-width: 22ch;
  }
  .sec-lede {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--color-ink-2);
    font-size: 1.02rem;
  }

  .aud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .aud__item {
    padding: 1.1rem 1.2rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-border);
    border-radius: 0 10px 10px 0;
  }
  .aud__who {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .aud__what {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
</style>

---
// Who I've communicated findings to.
// Data: profile.stakeholders — only audiences supported by real work.
import { profile } from "../data/profile";
---

<section class="section" id="stakeholders" aria-labelledby="stakeholders-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <p class="eyebrow">Communicating Evidence</p>
      <h2 id="stakeholders-heading" class="sec-title">
        Findings only matter if someone can act on them.
      </h2>
      <p class="sec-lede">
        Audiences I've translated research and evaluation findings for:
      </p>
    </div>

    <ul class="aud" role="list" data-reveal>
      {
        profile.stakeholders.map((s) => (
          <li>
            <details class="disc aud__item">
              <summary>
                <span class="aud__who">{s.audience}</span>
              </summary>
              <div class="disc__body">
                <p class="aud__what">{s.context}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sec-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .sec-title {
    font-size: var(--text-h2);
    margin-top: 0.5rem;
    max-width: 22ch;
  }
  .sec-lede {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--color-ink-2);
    font-size: 1.02rem;
  }

  .aud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 2.5rem;
  }
  @media (min-width: 780px) {
    .aud {
      grid-template-columns: 1fr 1fr;
    }
  }
  .aud > li:last-child .aud__item,
  .aud > li:nth-last-child(2) .aud__item {
    border-bottom: 1px solid var(--color-border);
  }
  .aud__item > summary:hover .aud__who {
    color: var(--color-accent);
  }
  .aud__who {
    flex: 1;
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
    transition: color 0.15s;
  }
  .aud__what {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 52ch;
  }
</style>

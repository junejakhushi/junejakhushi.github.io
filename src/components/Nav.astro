---
// Sticky, auto-hiding top nav with anchor links + a persistent
// Email affordance (refinement §9 removed the resume affordance).
import { profile } from "../data/profile";

const links = [
  { href: "#work", label: "Work" },
  { href: "#projects", label: "Projects" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <a class="nav__brand" href="#top" aria-label={`${profile.name} — home`}>
      <span class="nav__mark" aria-hidden="true">KJ</span>
      <span class="nav__name">Khushi Juneja</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__cta">
      <a
        class="nav__link-out"
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener">LinkedIn</a
      >
      <a class="nav__email" href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-cream) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s,
      background 0.3s;
  }
  /* subtle border appears once scrolled */
  .nav[data-scrolled] {
    border-bottom-color: var(--color-border);
  }
  /* auto-hide when scrolling down, reveal when scrolling up */
  .nav[data-hidden] {
    transform: translateY(-100%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
  }
  .nav__mark {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 7px;
    background: var(--color-ink);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .nav__name {
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
  }
  .nav__links a {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    position: relative;
    padding-block: 0.25rem;
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--color-accent);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .nav__link-out {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .nav__link-out:hover {
    color: var(--color-accent);
  }
  .nav__email {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    line-height: 1;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: 1px solid var(--color-accent);
  }
  .nav__email:hover {
    background: var(--color-accent-strong);
    color: var(--color-accent-ink);
  }

  /* Hide section links on small screens; brand + Email remain */
  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
    .nav__name {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .nav__link-out {
      display: none;
    }
  }
</style>

<script>
  // Auto-hide on scroll down, reveal on scroll up; border once scrolled.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    let last = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
      // only hide well past the hero, and only on meaningful downward movement
      if (y > 240 && y > last + 4) nav.setAttribute("data-hidden", "");
      else if (y < last - 4) nav.removeAttribute("data-hidden");
      last = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>

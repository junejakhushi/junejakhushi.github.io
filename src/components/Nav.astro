---
// Sticky, auto-hiding top nav: section anchors, an email affordance,
// and a light/dark toggle. Anchors resolve against the homepage so
// detail pages link back with "/".
import { profile } from "../data/profile";

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#community", label: "People" },
  { href: "/#experience", label: "Experience" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <a class="nav__brand" href="/" aria-label={`${profile.name}, home`}>
      <span class="nav__mark" aria-hidden="true">KJ</span>
      <span class="nav__name">Khushi Juneja</span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__cta">
      <a class="nav__email" href={`mailto:${profile.email}`}>Email</a>
      <button
        class="nav__theme"
        type="button"
        data-theme-toggle
        aria-label="Switch colour theme"
        title="Switch colour theme"
      >
        <span class="nav__theme-icon nav__theme-icon--sun" aria-hidden="true"
          >☀</span
        >
        <span class="nav__theme-icon nav__theme-icon--moon" aria-hidden="true"
          >☾</span
        >
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-cream) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s,
      background 0.3s;
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--color-border);
  }
  .nav[data-hidden] {
    transform: translateY(-100%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
  }
  .nav__mark {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 7px;
    background: var(--color-ink);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .nav__name {
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
  }
  .nav__links a {
    color: var(--color-ink-2);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    position: relative;
    padding-block: 0.25rem;
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--color-accent);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav__email {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border-radius: 8px;
    line-height: 1;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border: 1px solid var(--color-accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav__email:hover {
    background: var(--color-accent-strong);
    color: var(--color-accent-ink);
  }

  .nav__theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-ink-2);
    font-size: 1rem;
    line-height: 1;
    position: relative;
  }
  .nav__theme:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-border);
  }
  .nav__theme-icon {
    grid-area: 1 / 1;
  }
  /* Show the icon for the theme you'd switch TO. */
  .nav__theme-icon--sun {
    display: none;
  }
  :root[data-theme="dark"] .nav__theme-icon--sun {
    display: block;
  }
  :root[data-theme="dark"] .nav__theme-icon--moon {
    display: none;
  }

  @media (max-width: 940px) {
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .nav__name {
      display: none;
    }
  }
</style>

<script>
  // Auto-hide on scroll down, reveal on scroll up; border once scrolled.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    let last = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      if (y > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
      if (y > 240 && y > last + 4) nav.setAttribute("data-hidden", "");
      else if (y < last - 4) nav.removeAttribute("data-hidden");
      last = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }

  // Theme toggle: flip data-theme, persist, update the browser chrome colour.
  const root = document.documentElement;
  const btn = document.querySelector("[data-theme-toggle]");
  btn?.addEventListener("click", () => {
    const next =
      root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>

---
// Sticky nav. Name left; section links + theme toggle right. Links use
// /#section so they work from the detail pages too. Collapses to a menu
// button on mobile. All behaviour is progressive: with no JS the links
// still work and the page is fully usable.
import site from "../data/site.json";
const links = [
  { href: "/#experience", label: "Experience", id: "experience" },
  { href: "/#projects", label: "Projects", id: "projects" },
  { href: "/#education", label: "Education", id: "education" },
  { href: "/#skills", label: "Skills", id: "skills" },
  { href: "/#contact", label: "Contact", id: "contact" },
];
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__name" href="/">{site.name}</a>
    <div class="nav__right">
      <nav class="nav__links" id="nav-links" aria-label="Sections">
        {links.map((l) => <a href={l.href} data-nav={l.id}>{l.label}</a>)}
      </nav>
      <button
        class="nav__toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle dark and light"
      >
        Theme
      </button>
      <button
        class="nav__menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
        data-menu-btn
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script>
  // Theme toggle (persisted).
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });

  // Mobile menu.
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  const linksEl = document.getElementById("nav-links");
  menuBtn?.addEventListener("click", () => {
    const open = linksEl?.classList.toggle("open");
    menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
  });
  linksEl?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      linksEl.classList.remove("open");
      menuBtn?.setAttribute("aria-expanded", "false");
    }
  });

  // Active-section highlight (home page only; a no-op elsewhere).
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav]"),
  );
  const sections = navLinks
    .map((l) => document.getElementById(l.dataset.nav || ""))
    .filter((s): s is HTMLElement => Boolean(s));
  if (sections.length && "IntersectionObserver" in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((l) =>
              l.setAttribute(
                "aria-current",
                l.dataset.nav === entry.target.id ? "true" : "false",
              ),
            );
          }
        });
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>

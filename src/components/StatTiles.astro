---
// "At a glance" — compact dashboard tiles of verified numbers.
// Each tile expands to show what the number actually measures and
// where it came from (press-to-expand; nothing is claimed bare).
// Data: src/data/metrics.ts
import { impactStats } from "../data/metrics";
---

<section class="glance" aria-labelledby="glance-heading">
  <div class="shell">
    <h2 id="glance-heading" class="sr-only">Selected results at a glance</h2>
    <ul class="tiles" role="list">
      {
        impactStats.map((s) => (
          <li class="tile">
            <details class="tile__d">
              <summary>
                <span class="tile__value">
                  {s.direction === "down" && (
                    <span class="tile__arrow" aria-hidden="true">
                      ↓
                    </span>
                  )}
                  {s.value}
                </span>
                <span class="tile__label">{s.label}</span>
                <span class="tile__src">{s.source}</span>
              </summary>
              <p class="tile__context">{s.context}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .glance {
    padding-block: 0 clamp(1.5rem, 4vw, 2.5rem);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 2-up on phones, 4-up once there's room — the row reads as a
     dashboard rather than a stack of banners. */
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
  }

  .tile {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .tile__d {
    height: 100%;
  }
  .tile__d > summary {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0.85rem;
    cursor: pointer;
    list-style: none;
    position: relative;
  }
  .tile__d > summary::-webkit-details-marker {
    display: none;
  }
  /* small + / − affordance */
  .tile__d > summary::after {
    content: "+";
    position: absolute;
    top: 0.7rem;
    right: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-muted);
  }
  .tile__d[open] > summary::after {
    content: "−";
    color: var(--color-accent);
  }
  .tile__d > summary:hover::after {
    color: var(--color-accent);
  }
  .tile__d > summary:focus-visible {
    outline: 2.5px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: 10px;
  }

  .tile__value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .tile__arrow {
    font-size: 0.75em;
    margin-right: 0.05em;
  }
  .tile__label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.25;
  }
  .tile__src {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }

  .tile__context {
    padding: 0 1rem 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    border-top: 1px solid var(--color-border);
    padding-top: 0.7rem;
  }
</style>

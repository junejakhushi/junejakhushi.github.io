---
// Experience: reverse-chronological list. Role, org, dates, a one-line
// summary, and a muted Stack line. Order comes from the JSON array.
import experience from "../data/experience.json";
---

<section class="exp section" id="experience" aria-labelledby="exp-heading">
  <div class="shell">
    <header class="exp__head">
      <p class="eyebrow">Experience</p>
      <h2 id="exp-heading" class="exp__title">Where I have worked</h2>
    </header>

    <ol class="exp__list">
      {
        experience.map((job) => (
          <li class="exp__item">
            <div class="exp__top">
              <span class="exp__role">{job.role}</span>
              <time class="exp__dates">{job.dates}</time>
            </div>
            <p class="exp__org">{job.org}</p>
            <p class="exp__line">{job.summary}</p>
            <p class="exp__stack">
              <span class="exp__stack-label">Stack:</span> {job.stack}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .exp__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }

  .exp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .exp__item {
    padding-block: clamp(1.1rem, 2.5vw, 1.6rem);
    border-bottom: 1px solid var(--color-border);
  }

  .exp__top {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
  }
  .exp__role {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .exp__dates {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .exp__org {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .exp__line {
    margin-top: 0.55rem;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 66ch;
  }
  .exp__stack {
    margin-top: 0.55rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    max-width: 66ch;
  }
  .exp__stack-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin-right: 0.3rem;
  }

  @media (max-width: 560px) {
    .exp__top {
      flex-direction: column;
      gap: 0.3rem;
    }
    .exp__dates {
      order: -1;
    }
  }
</style>

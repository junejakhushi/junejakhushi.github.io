---
// Experience: reverse-chronological timeline. Each role shows a
// one-line summary and expands to 2 to 3 bullets. Order comes from
// the JSON array.
import experience from "../data/experience.json";
---

<section class="exp section" id="experience" aria-labelledby="exp-heading">
  <div class="shell">
    <header class="exp__head">
      <p class="eyebrow">Experience</p>
      <h2 id="exp-heading" class="exp__title">Where I have worked</h2>
    </header>

    <ol class="exp__list">
      {
        experience.map((job) => (
          <li class="exp__item">
            <details class="exp__d">
              <summary class="exp__summary">
                <span class="exp__text">
                  <span class="exp__role">{job.role}</span>
                  <span class="exp__org">{job.org}</span>
                  <span class="exp__line">{job.summary}</span>
                </span>
                <span class="exp__right">
                  <time class="exp__dates">{job.dates}</time>
                  <span class="exp__chev" aria-hidden="true" />
                </span>
              </summary>
              <ul class="exp__bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .exp__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }

  .exp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .exp__item {
    border-bottom: 1px solid var(--color-border);
  }

  .exp__d {
    width: 100%;
  }
  .exp__summary {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.5vw, 1.6rem);
    cursor: pointer;
    list-style: none;
  }
  .exp__summary::-webkit-details-marker {
    display: none;
  }
  .exp__summary:focus-visible {
    outline: 2.5px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .exp__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .exp__role {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .exp__org {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .exp__line {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    color: var(--color-ink-2);
    line-height: 1.5;
    max-width: 60ch;
  }

  .exp__right {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-shrink: 0;
  }
  .exp__dates {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .exp__chev {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.75px solid var(--color-muted);
    border-bottom: 1.75px solid var(--color-muted);
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.18s var(--ease-out);
  }
  .exp__d[open] .exp__chev {
    transform: translateY(2px) rotate(225deg);
  }
  .exp__summary:hover .exp__chev {
    border-color: var(--color-accent);
  }

  .exp__bullets {
    margin: 0 0 clamp(1.1rem, 2.5vw, 1.6rem);
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    max-width: 68ch;
  }
  .exp__bullets li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .exp__bullets li::marker {
    color: var(--color-accent);
  }

  @media (max-width: 560px) {
    .exp__summary {
      flex-direction: column;
      gap: 0.5rem;
    }
    .exp__right {
      order: -1;
    }
  }
</style>

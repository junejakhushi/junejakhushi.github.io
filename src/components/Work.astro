---
// Selected work: a featured row, then a filterable grid of every
// project. Filtering is client-side and progressive: with no JS the
// full grid simply shows.
import { getCollection } from "astro:content";
import { CATEGORIES } from "../content.config";
import ProjectCard from "./ProjectCard.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const filters = ["All", ...CATEGORIES] as const;
---

<section class="work section" id="work" aria-labelledby="work-heading">
  <div class="shell">
    <header class="work__head">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-heading" class="work__title">Things I have built</h2>
    </header>

    {
      featured.length > 0 && (
        <div class="work__featured" aria-label="Featured projects">
          {featured.map((entry) => (
            <ProjectCard entry={entry} />
          ))}
        </div>
      )
    }

    <div class="work__filterbar" role="group" aria-label="Filter projects by category">
      {
        filters.map((f, i) => (
          <button
            class="chip"
            type="button"
            data-filter={f}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {f}
          </button>
        ))
      }
    </div>

    <div class="work__grid" id="work-grid">
      {all.map((entry) => <ProjectCard entry={entry} />)}
    </div>
    <p class="work__empty" id="work-empty" hidden>No projects in that category yet.</p>
  </div>
</section>

<style>
  .work__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .work__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }

  .work__featured,
  .work__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .work__featured,
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .work__featured,
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work__filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 1.75rem;
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--color-border);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    line-height: 1;
    min-height: 40px;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .chip:hover {
    border-color: var(--color-accent-border);
    color: var(--color-ink);
  }
  .chip[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .work__empty {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-top: 1rem;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".work__filterbar");
  const grid = document.getElementById("work-grid");
  const empty = document.getElementById("work-empty");
  if (bar && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
    bar.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-filter]");
      if (!btn) return;
      const filter = btn.dataset.filter || "All";
      bar.querySelectorAll("[data-filter]").forEach((b) =>
        b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
      );
      let shown = 0;
      cards.forEach((card) => {
        const cats = (card.dataset.categories || "").split("|");
        const match = filter === "All" || cats.includes(filter);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  }
</script>

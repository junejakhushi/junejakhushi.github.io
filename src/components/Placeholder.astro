---
// Monochrome monogram tile, shown until a project has a real
// screenshot (set `image` in the project's frontmatter). Decorative:
// aria-hidden, with the project title always present in the card.
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
const mark =
  label ||
  title
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<div class="ph" aria-hidden="true">
  <svg viewBox="0 0 1200 750" preserveAspectRatio="xMidYMid slice" role="presentation">
    <rect width="1200" height="750" fill="var(--color-surface-2)"></rect>
    <g stroke="var(--color-border-strong)" stroke-width="1.5" opacity="0.6">
      <line x1="0" y1="188" x2="1200" y2="188"></line>
      <line x1="0" y1="562" x2="1200" y2="562"></line>
    </g>
    <text
      x="80"
      y="500"
      font-family="Fraunces Variable, Fraunces, Georgia, serif"
      font-size="340"
      font-weight="600"
      letter-spacing="-10"
      fill="var(--color-ink)">{mark}</text>
    <circle cx="1120" cy="90" r="18" fill="var(--color-accent)"></circle>
  </svg>
</div>

<style>
  .ph {
    position: absolute;
    inset: 0;
  }
  .ph svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

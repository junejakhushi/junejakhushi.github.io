---
// "Things I do with people." The community-building section. Real
// entries plus visibly marked TODO placeholders Khushi fills in.
import { communityIntro, community } from "../data/community";
---

<section class="people section" id="community" aria-labelledby="people-heading">
  <div class="shell">
    <header class="people__head" data-reveal>
      <p class="eyebrow">Things I do with people</p>
      <h2 id="people-heading" class="people__title">
        I keep organising the room
      </h2>
      <p class="people__intro">{communityIntro}</p>
    </header>

    <ul class="people__grid">
      {
        community.map((c) => (
          <li
            class:list={["pcell", c.todo && "pcell--todo"]}
            data-reveal
          >
            {c.meta && <p class="pcell__meta meta">{c.meta}</p>}
            <h3 class="pcell__title">
              {c.todo && <span class="pcell__flag">To add</span>}
              {c.title}
            </h3>
            <p class="pcell__blurb">{c.blurb}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .people__head {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .people__title {
    font-size: var(--text-h2);
    margin-top: 0.7rem;
    max-width: 18ch;
  }
  .people__intro {
    margin-top: 1.25rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .people__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
  }
  @media (min-width: 720px) {
    .people__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pcell {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .pcell__meta {
    margin-bottom: 0.7rem;
  }
  .pcell__title {
    font-size: 1.3rem;
    line-height: 1.15;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .pcell__blurb {
    margin-top: 0.7rem;
    color: var(--color-ink-2);
    line-height: 1.62;
    font-size: 0.98rem;
  }

  .pcell--todo {
    background: transparent;
    border-style: dashed;
    border-color: var(--color-border-strong);
  }
  .pcell--todo .pcell__blurb {
    color: var(--color-muted);
    font-style: italic;
  }
  .pcell__flag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    align-self: center;
  }
</style>

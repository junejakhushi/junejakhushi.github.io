---
// Project detail pages, statically generated for every project that
// has a `story`. Everything else lives as a single entry on the
// homepage. No empty routes.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Placeholder from "../../components/Placeholder.astro";
import FindingChart from "../../components/FindingChart.astro";
import { projectsWithPages } from "../../data/projects";

export function getStaticPaths() {
  const paged = projectsWithPages();
  return paged.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: i > 0 ? paged[i - 1] : null,
      next: i < paged.length - 1 ? paged[i + 1] : null,
    },
  }));
}

const { project: p, prev, next } = Astro.props;
const story = p.story!;
---

<Base title={`${p.title} | Khushi Juneja`} description={p.blurb}>
  <Nav />

  <main id="main">
    <article class="cs">
      <header class="cs__header">
        <div class="shell cs__header-inner">
          <a class="cs__back" href="/#work">
            <span aria-hidden="true">←</span> All work
          </a>

          <p class="meta cs__kicker">
            <span>{p.year}</span>
            {p.kind && <span class="cs__kind">{p.kind}</span>}
          </p>

          <h1 class="cs__title">{p.title}</h1>
          {p.subtitle && <p class="cs__subtitle">{p.subtitle}</p>}
          <p class="cs__intro">{story.intro}</p>

          <ul class="cs__tags" aria-label="Tags">
            {p.tags.map((t) => <li>{t}</li>)}
          </ul>
          {
            p.tech && (
              <p class="cs__tech">
                <span>Built with</span> {p.tech.join(", ")}
              </p>
            )
          }
        </div>
      </header>

      <div class="shell cs__media-wrap">
        <div class="cs__media">
          {
            p.image ? (
              <img
                src={p.image.src}
                alt={p.image.alt}
                width="1200"
                height="750"
              />
            ) : (
              <Placeholder placeholder={p.placeholder} title={p.title} />
            )
          }
        </div>
      </div>

      <div class="shell cs__body">
        {
          story.sections.map((s) => (
            <section class:list={["cs__section", s.todo && "cs__section--todo"]}>
              <h2 class="cs__h2">
                {s.todo && <span class="cs__todo-tag">To add</span>}
                {s.heading}
              </h2>
              {s.body.map((para) => (
                <p class="cs__prose">{para}</p>
              ))}
            </section>
          ))
        }

        {
          story.finding && (
            <section class="cs__section" aria-label="Headline finding">
              <FindingChart finding={story.finding} />
            </section>
          )
        }

        <nav class="cs__next" aria-label="More work">
          {
            prev ? (
              <a href={`/projects/${prev.slug}`}>← {prev.title}</a>
            ) : (
              <a href="/#work">← All work</a>
            )
          }
          {
            next ? (
              <a href={`/projects/${next.slug}`}>{next.title} →</a>
            ) : (
              <a href="/#contact">Get in touch →</a>
            )
          }
        </nav>
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .cs__header {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .cs__header-inner {
    max-width: 54rem;
  }
  .cs__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
  }
  .cs__back:hover {
    color: var(--color-accent);
  }
  .cs__kicker {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin-top: 1.5rem;
  }
  .cs__kind {
    color: var(--color-accent-strong);
  }
  .cs__title {
    margin-top: 0.7rem;
    font-size: clamp(2.1rem, 6vw, 4rem);
    line-height: 1;
  }
  .cs__subtitle {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cs__intro {
    margin-top: 1.25rem;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 52ch;
  }
  .cs__tags {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cs__tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    line-height: 1;
  }
  .cs__tech {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-muted);
  }
  .cs__tech span {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 0.4rem;
  }

  .cs__media-wrap {
    margin-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .cs__media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .cs__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cs__body {
    max-width: 54rem;
    padding-bottom: clamp(3rem, 7vw, 4.5rem);
  }
  .cs__section + .cs__section {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }
  .cs__h2 {
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    margin-bottom: 0.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .cs__prose {
    font-size: 1.05rem;
    line-height: 1.72;
    color: var(--color-ink-2);
    max-width: 64ch;
  }
  .cs__prose + .cs__prose {
    margin-top: 1rem;
  }

  .cs__section--todo {
    border: 1px dashed var(--color-border-strong);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    background: var(--color-surface-2);
  }
  .cs__section--todo .cs__prose {
    color: var(--color-muted);
    font-style: italic;
  }
  .cs__todo-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .cs__next {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cs__next a {
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cs__next a:hover {
    text-decoration: underline;
  }
</style>

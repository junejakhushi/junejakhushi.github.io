---
// Dedicated case-study pages, statically generated from
// src/data/caseStudies.ts. Every slug renders a complete page —
// there are no empty project routes.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Banner from "../../components/Banner.astro";
import Footer from "../../components/Footer.astro";
import EvidenceChain from "../../components/EvidenceChain.astro";
import FindingChart from "../../components/FindingChart.astro";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const isLoop = study.slug === "llm-evaluation-educational-feedback";
// The reflection finding belongs to this study only.
const showFinding = study.slug === "learning-analytics-ai-tutoring";
---

<Base title={`${study.title} | Khushi Juneja`} description={study.summary}>
  <Banner />
  <Nav />

  <main id="main">
    <article class="cs">
      <header class="cs__header">
        <div class="shell cs__header-inner">
          <a class="cs__back" href="/#featured">
            <span aria-hidden="true">←</span> All work
          </a>

          <div class="cs__meta">
            <span class:list={["cs__status", `cs__status--${study.status.toLowerCase()}`]}>
              {study.status}
            </span>
            {study.scale && <span class="cs__scale">{study.scale}</span>}
          </div>

          <h1 class="cs__title">{study.title}</h1>
          <p class="cs__summary">{study.summary}</p>

          <dl class="cs__facts">
            <div>
              <dt>My role</dt>
              <dd>{study.role}</dd>
            </div>
            <div>
              <dt>Tools</dt>
              <dd>{study.tools.join(" · ")}</dd>
            </div>
          </dl>
        </div>
      </header>

      <div class="shell cs__body">
        <section class="cs__section" aria-labelledby="cs-problem">
          <h2 id="cs-problem" class="cs__h2">Problem</h2>
          <p class="cs__prose">{study.problem}</p>
        </section>

        <section class="cs__section" aria-labelledby="cs-questions">
          <h2 id="cs-questions" class="cs__h2">Research questions</h2>
          <ul class="cs__list cs__list--q">
            {study.researchQuestions.map((q) => <li>{q}</li>)}
          </ul>
        </section>

        <section class="cs__section" aria-labelledby="cs-data">
          <h2 id="cs-data" class="cs__h2">Data</h2>
          <ul class="cs__list cs__list--chips">
            {study.data.map((d) => <li>{d}</li>)}
          </ul>
        </section>

        <section class="cs__section" aria-labelledby="cs-methods">
          <h2 id="cs-methods" class="cs__h2">Methods</h2>
          <ul class="cs__list cs__list--chips">
            {study.methods.map((m) => <li>{m}</li>)}
          </ul>
        </section>

        <section class="cs__section" aria-labelledby="cs-chain">
          <h2 id="cs-chain" class="cs__h2">How the evidence moves</h2>
          <EvidenceChain
            steps={study.diagram}
            alt={study.diagramAlt}
            loop={isLoop}
          />
        </section>

        {
          showFinding && (
            <section class="cs__section" aria-label="Headline finding">
              <FindingChart />
            </section>
          )
        }

        <section class="cs__section" aria-labelledby="cs-outcome">
          <h2 id="cs-outcome" class="cs__h2">Outcome</h2>
          <ul class="cs__list cs__list--prose">
            {study.outcome.map((o) => <li>{o}</li>)}
          </ul>
        </section>

        <nav class="cs__next" aria-label="More work">
          <a href="/#featured">← Back to all work</a>
          <a href="/#contact">Get in touch →</a>
        </nav>
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style>
  .cs__header {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
  }
  .cs__header-inner {
    max-width: 54rem;
  }

  .cs__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
  }
  .cs__back:hover {
    color: var(--color-accent);
  }

  .cs__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .cs__status {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.14rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent-border);
    color: var(--color-accent);
    background: var(--color-accent-tint);
  }
  .cs__status--completed {
    color: var(--color-ink-2);
    background: transparent;
    border-color: var(--color-border-strong);
  }
  .cs__scale {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .cs__title {
    margin-top: 0.85rem;
    font-size: clamp(1.9rem, 5vw, 3.1rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .cs__summary {
    margin-top: 1.1rem;
    font-size: clamp(1.02rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  .cs__facts {
    margin: 1.75rem 0 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .cs__facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cs__facts dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }
  .cs__facts dd {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .cs__body {
    max-width: 54rem;
    padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 7vw, 4.5rem);
  }
  .cs__section + .cs__section {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  .cs__h2 {
    font-size: clamp(1.25rem, 2.6vw, 1.65rem);
    margin-bottom: 0.9rem;
  }
  .cs__prose {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-ink-2);
    max-width: 64ch;
  }

  .cs__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cs__list--q {
    display: grid;
    gap: 0.6rem;
    max-width: 64ch;
  }
  .cs__list--q li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink);
    font-weight: 500;
  }
  .cs__list--q li::before {
    content: "?";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-accent);
  }

  .cs__list--chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cs__list--chips li {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-ink-2);
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
  }

  .cs__list--prose {
    display: grid;
    gap: 0.75rem;
    max-width: 64ch;
  }
  .cs__list--prose li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }
  .cs__list--prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent-border);
  }

  .cs__next {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cs__next a {
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cs__next a:hover {
    text-decoration: underline;
  }
</style>

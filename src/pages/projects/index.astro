---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
---

<Base title="Projects | Khushi Juneja" description="Everything Khushi Juneja has built: software, research, games, and hardware.">
  <Nav />
  <main id="main">
    <section class="projects section">
      <div class="shell">
        <header class="projects__head">
          <a class="projects__back" href="/"><span aria-hidden="true">←</span> Home</a>
          <p class="eyebrow">Projects</p>
          <h1 class="projects__title">Everything I have built</h1>
          <p class="projects__intro">
            Software, research, games, and hardware. Filter by what you care about.
          </p>
        </header>
        <ProjectGrid />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .projects__head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .projects__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    margin-bottom: 1.25rem;
  }
  .projects__back:hover {
    color: var(--color-accent-strong);
  }
  .projects__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }
  .projects__intro {
    margin-top: 1rem;
    color: var(--color-ink-2);
    font-size: 1.05rem;
    max-width: 48ch;
  }
</style>

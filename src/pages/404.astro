---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Not found | Khushi Juneja" description="That page does not exist.">
  <Nav />
  <main id="main" class="nf">
    <div class="shell nf__inner">
      <p class="meta">Error 404</p>
      <h1 class="nf__title">This page wandered off.</h1>
      <p class="nf__text">The page you were after does not exist, or it moved.</p>
      <a class="nf__home" href="/">← Back home</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .nf__title {
    font-size: var(--text-h2);
    margin-top: 0.6rem;
  }
  .nf__text {
    margin-top: 1rem;
    color: var(--color-ink-2);
    font-size: 1.05rem;
    max-width: 44ch;
  }
  .nf__home {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nf__home:hover {
    text-decoration: underline;
  }
</style>
